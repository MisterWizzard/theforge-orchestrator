{
  "name": "@theforge/coordinator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/server.ts --format esm --dts",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/server.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@theforge/contracts": "workspace:*",
    "@theforge/db": "workspace:*",
    "@theforge/domain": "workspace:*",
    "@theforge/git-runtime": "workspace:*",
    "@theforge/observability": "workspace:*",
    "@theforge/policy": "workspace:*",
    "@theforge/providers": "workspace:*",
    "@theforge/queue": "workspace:*",
    "@theforge/workflows": "workspace:*",
    "fastify": "^5.12.1",
    "zod": "^3.25.76",
    "@theforge/guardrails": "workspace:*",
    "@theforge/notify": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  }
}
