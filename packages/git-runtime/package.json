  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.0",
    "@theforge/policy": "workspace:*"
  },
