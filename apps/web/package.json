{
  "name": "@theforge/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env node_modules/next/dist/bin/next dev -H 127.0.0.1 -p 3000",
    "start": "node --env-file-if-exists=../../.env node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "pnpm -w run test:prepare && pnpm -w exec vitest run apps/web"
  },
  "dependencies": {
    "next": "^15.5.27",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6"
  }
}
