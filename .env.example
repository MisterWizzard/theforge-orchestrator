NODE_ENV=development
DATABASE_URL=postgres://forge:forge@localhost:5432/forge
REDIS_URL=redis://localhost:6379
FORGE_API_URL=http://localhost:4400
FORGE_WEB_ORIGIN=http://127.0.0.1:3000
FORGE_WORKSPACE_ROOT=.forge/workspaces
FORGE_WORKER_ID=replace-with-a-stable-machine-identifier
FORGE_SANDBOX_IMAGE=theforge-worker-sandbox:local
FORGE_JOB_HEARTBEAT_MS=10000
FORGE_VOLATILE_MODE=false
# Replace both tokens with independent random values of 32+ characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The placeholders are deliberately too short to be accepted.
FORGE_WORKER_TOKEN=replace-with-32-random-chars
FORGE_COORDINATOR_TOKEN=replace-with-32-random-chars
# Optional credentials must be absent, not empty: an empty value is treated as unset, so uncomment a line only once you have a value for it.
# GITHUB_TOKEN=
# ANTHROPIC_API_KEY=
# FORGE_ANTHROPIC_WORKSPACE_ID=     only if the key is not scoped to a workspace (the API answers 400 "not scoped to a workspace"): wrkspc_..., not a secret
# OPENAI_API_KEY=
# FORGE_CODEX_AUTH_FILE=
# Optional settings, shown with their defaults.
# PORT=4400                      coordinator listen port
# HOST=127.0.0.1                 coordinator bind address
# FORGE_JOB_LEASE_MS=30000       worker job lease in milliseconds (1000-300000)
# FORGE_WORKER_EXECUTOR=docker   docker or host; host is test-only
# FORGE_GIT_AUTHOR_NAME=TheForge
# FORGE_GIT_AUTHOR_EMAIL=theforge@users.noreply.github.com
# Kill switch: FORGE_HALT_FILE is optional; empty means <absolute FORGE_WORKSPACE_ROOT>/../FORGE_HALT from the coordinator's working directory
FORGE_HALT_FILE=
# Guardrails (docs/OPERATIONS.md "Guardrails in dispatch"). Optional; shown with their defaults.
# Coordinator - the daily cloud ceiling (policies B2/B3) and the concurrency cap (B8):
# FORGE_DAILY_CEILING_USD=20        cloud spend allowed per local day, in USD (0-10000; 0 = no cloud calls at all)
# FORGE_CEILING_WARN_FRACTION=0.75  emit spend.warn once per day at this fraction of the ceiling (0-1)
# Adaptive monthly budget (ADR-037). With FORGE_MONTHLY_BUDGET_USD set, FORGE_DAILY_CEILING_USD becomes the floor of a
# daily cap that spreads the unspent allowance over the days left, so a quiet stretch raises the cap for the rest of the period:
# FORGE_MONTHLY_BUDGET_USD=200      credit allowance per period, in USD (above 0); leave out for the flat ceiling
# FORGE_BUDGET_RESET_DAY=1          day of the month (1-28) the allowance resets; unspent credit is lost at the reset
# FORGE_MAX_DAILY_CEILING_USD=50    the most any one day may be capped at, however much is left (runaway guard)
# FORGE_BUDGET_COUNT_FROM=          ISO date or timestamp; usage recorded before it (e.g. spend that was never billed) is not counted
# FORGE_MAX_AGENTS=4                leased provider jobs allowed at once, each one a running agent (1-64)
# FORGE_MIN_FREE_MEMORY_MB=3072     refuse every lease while the coordinator host has less free memory than this (0-1048576)
# FORGE_TIMEZONE=Australia/Sydney   IANA zone whose calendar days the ceiling counts in
# Worker - per-task bounds; a provider job that trips one is aborted and fails with a TASK_LIMIT error:
# FORGE_TASK_MAX_TOOL_CALLS=200     tool requests per provider job (1-100000)
# FORGE_TASK_MAX_MINUTES=30         wall-clock minutes per provider job (1-1440)
# FORGE_TASK_MAX_TOKENS=150000      input plus output tokens per provider job (1000-100000000)

# Notifications (policy B9/B11): Home Assistant push and email, plus a file outbox that is always on.
# Severity routing (ADR-023): warn and critical reach the phone, email and the outbox; info reaches email and the
# outbox only. Nothing overrides the phone's Do Not Disturb. Prove a channel with `pnpm forge notify-test`.
# Both secrets are Dan-only manual actions; leave the lines commented until you have the values.
# FORGE_HA_URL=http://192.168.1.10/ha     Home Assistant base URL; the REST API is at <base>/api/...
# FORGE_HA_TOKEN=                           long-lived access token from your Home Assistant profile
# FORGE_HA_NOTIFY_SERVICE=mobile_app_phone   notify service (companion app), without the notify. prefix
# FORGE_SMTP_HOST=smtp.gmail.com            implicit TLS
# FORGE_SMTP_PORT=465
# FORGE_SMTP_USER=operator@example.com  the Gmail account that sends
# FORGE_SMTP_PASSWORD=                      a Gmail app password, not the account password
# FORGE_NOTIFY_EMAIL_TO=operator@example.com
# FORGE_OUTBOX_DIR=                         escalation files and Tier 0 outcomes; empty means <absolute FORGE_WORKSPACE_ROOT>/../outbox

# Digests (policy B12; docs/OPERATIONS.md "Daily digests"). `pnpm forge digest` reads DATABASE_URL, FORGE_TIMEZONE,
# FORGE_DAILY_CEILING_USD, FORGE_CEILING_WARN_FRACTION, FORGE_HALT_FILE, FORGE_OUTBOX_DIR and the notification variables
# above; FORGE_API_URL plus FORGE_COORDINATOR_TOKEN add the coordinator health line. Nothing else is needed.
# FORGE_REMINDERS_FILE=                plain text, one reminder per line, optional "YYYY-MM-DD " prefix = show from that day; empty means <outbox>/reminders.md
# FORGE_DIGEST_LOG_DIR=C:\forge\logs   where scripts/run-digest.ps1 (the Task Scheduler wrapper) appends digest-<yyyyMMdd>.log

# Runtime (docs/OPERATIONS.md "Running TheForge as a service on Windows"). Optional; shown with their defaults.
# FORGE_LOG_DIR=C:\forge\logs   where run-coordinator.ps1 and run-worker.ps1 append <app>-<yyyyMMdd>.log (14 kept); keep in step with register-runtime.ps1 -LogDir
# FORGE_PWSH=pwsh               PowerShell 7 executable that `pnpm forge runtime status|start|stop` spawns to reach Task Scheduler
# FORGE_REPO_ROOT=              repository root for `pnpm forge runtime doctor`; empty means the working directory
# FORGE_WEB_HOST=127.0.0.1     address `pnpm forge runtime doctor` probes for the control centre; keep in step with run-web.ps1 -Hostname
# FORGE_WEB_PORT=3000          port it probes, which is also the tailscale serve target; keep in step with run-web.ps1 -Port

# Local models (ADR-021; docs/OPERATIONS.md "Local models"). Optional; shown with their defaults.
# The worker probes the server at startup and advertises provider:ollama plus model:<name> per listed model.
# An ollama provider job runs in the worker process, never in the sandbox, and never counts against the ceiling.
# FORGE_OLLAMA_URL=http://127.0.0.1:11434   Ollama base URL the worker probes and calls
# FORGE_LOCAL_SKILLS=off      on: role playbooks and repository conventions for planner and critic stages routed to a local model (ADR-045; measure first with pnpm forge local-scoreboard)
# FORGE_OLLAMA_NUM_CTX_TIER1=8192           num_ctx for qwen3:8b (tier 1; 5.9 GB resident, measured 26/09/2026)
# FORGE_OLLAMA_NUM_CTX_TIER2=16384          num_ctx for devstral-small-2:latest (tier 2; 15.8 GB resident)

# Worktrees and retries (docs/OPERATIONS.md "Worktrees and retries"). Optional; shown with the default.
# FORGE_STAGE_TIMEOUT_MS=1800000    wall clock for ONE provider attempt (planner, critic, builder, reviewer) in milliseconds (min 1000); 30 minutes by default to match FORGE_TASK_MAX_MINUTES and the per-task wall clock, since all three bound the same thing
# FORGE_WORKER_JOB_WAIT_MS=900000   active milliseconds a QUEUED worker job may wait for a compatible worker to lease it (min 1000); time under the halt file does not count. Queued only since 05/10/2026 - it used to bound queued plus executing together, and one number cannot be right for both, so executing time moved to FORGE_WORKER_JOB_EXECUTION_MS
# FORGE_WORKER_JOB_EXECUTION_MS=2100000  active milliseconds a LEASED worker job gets to finish, counted from the lease (min 1000); halted time does not count. Defaults to FORGE_STAGE_TIMEOUT_MS + 5 minutes, because it bounds the stage's own wall clock PLUS the lease, the workspace materialisation and the transport of the result - at 30 minutes each a builder stage finished with code 0 and the coordinator had already cancelled the job. The 5 minutes also clears the worker's container deadline of (FORGE_TASK_MAX_MINUTES + 1) minutes

# Cold coordinator starts (ADR-029; docs/OPERATIONS.md "Waiting for a worker after a restart"). Optional; shown with the default.
# A coordinator that has just started has no online worker for the first seconds of its life, so a run resumed across a
# restart or a reboot used to fail on that reading with "No authenticated provider is available". The wait applies only while
# NO worker is online; once one is, a provider it does not advertise (Codex not logged in) still fails the run at once.
# FORGE_PROVIDER_WAIT_MS=90000   milliseconds a resumed run waits for a worker to advertise a provider before it is PAUSED, not failed (0-3600000; 0 = fail at once)

# Failed workspaces (docs/OPERATIONS.md "Failed workspaces"). Optional; shown with their defaults.
# A job that fails or is cancelled keeps its workspace under <FORGE_WORKSPACE_ROOT>/.failed with a RETAINED.json,
# for a human with disk access; a job that succeeds is removed as before. The worker sweeps the directory at startup
# and after every retention. Nothing serves these files: provider and check output in them can contain secrets.
# FORGE_FAILED_WORKSPACE_KEEP=5             newest failed workspaces kept (0-1000; 0 keeps none)
# FORGE_FAILED_WORKSPACE_MAX_AGE_HOURS=72   a kept workspace older than this is removed at the next sweep (1-8760)

# Raw provider output (docs/OPERATIONS.md "Raw provider output"). Optional; shown with its default.
# The worker tees a sandboxed CLI provider's stdout and stderr and attaches the redacted last 1,000,000 bytes of each
# to the job result as rawStdoutTail / rawStderrTail, readable only through GET /api/runs/:id/jobs with the coordinator
# token. Redaction is best effort (known credentials plus generic key, bearer, JWT and JSON credential-field shapes).
# FORGE_RAW_OUTPUT=failure   failure: failed provider jobs only; always: every provider job; never: none

# Web control centre (ADR-027; docs/OPERATIONS.md "Operator login"). Required: without it the web app answers 503 to
# everything but /login and /forge-api/health. 16+ characters; the placeholder is deliberately too short to be accepted.
FORGE_WEB_OPERATOR_PASSWORD=replace-me
# FORGE_WEB_SESSION_SECRET=   optional, 16+ random characters that sign the session cookie; derived from the password when unset

# Tailnet node watch (ADR-031; docs/OPERATIONS.md "Tailnet node watch"). Optional. `pnpm forge node-watch` reads
# `tailscale status --json` (PATH, else C:\Program Files\Tailscale\tailscale.exe), FORGE_OUTBOX_DIR and the notification
# variables above. A watched node coming back online is a warn, one going offline is an info.
# FORGE_WATCH_NODES=                    comma-separated short node names, e.g. noded,nodec; EMPTY MEANS EVERY NODE, so an unexpected node joining is reported too
# FORGE_NODE_WATCH_LOG_DIR=C:\forge\logs   where scripts/run-node-watch.ps1 (the Task Scheduler wrapper) appends node-watch-<yyyyMMdd>.log

# Which scheduled tasks the digest watches for silent failure (ADR-033). A leading `+`
# adds to TheForge's own seven tasks; without it this list replaces them. Other projects'
# tasks belong here rather than in the code.
# FORGE_WATCH_TASKS=+Backup task,Offsite task
